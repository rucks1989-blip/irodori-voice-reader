{
  "manifest_version": 3,
  "name": "Irodori Voice Reader",
  "version": "1.2.24",
  "description": "ChatGPT・Gemini・Muse・選択文章をローカルIrodori-TTSで読み上げます。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "tabs",
    "nativeMessaging",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "chrome-compat.js",
        "adapters.js",
        "muse-watcher.js",
        "chatgpt-watcher.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Irodori Voice Reader",
    "default_icon": {
      "128": "icons/irodori.png"
    }
  },
  "icons": {
    "128": "icons/irodori.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "選択範囲をIrodoriで読み上げ"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "読み上げを停止"
    }
  }
}
