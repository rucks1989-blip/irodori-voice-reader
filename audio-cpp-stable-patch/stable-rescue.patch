+  }
+  names.emplace_back("guided");
+  for (size_t index = 0; index < branches.size() && index < 5; ++index) {
+    debug::trace_log_scalar(prefix + names[index] + "_stats",
+                            rf_vector_stats(branches[index]));
+  }
+  if (text_cfg_enabled && speaker_cfg_enabled && branches.size() >= 3) {
+    debug::trace_log_scalar(
+        prefix + "text_speaker_diff_cosine",
+        std::to_string(rf_cosine(branches[1], branches[2])));
+  }
+}
+
+void log_speaker_cfg_analysis(
+    int64_t step,
+    const std::vector<std::vector<float>> &branches,
+    bool text_cfg_enabled, bool speaker_cfg_enabled,
+    float text_scale, float spk_scale) {
+  if (!text_cfg_enabled || !speaker_cfg_enabled || branches.size() < 3) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: CFG branches missing"));
+    return;
+  }
+  if (!std::isfinite(text_scale) || !std::isfinite(spk_scale)) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: scale is not finite"));
+    return;
+  }
+  const auto &cond = branches[0];
+  const auto &text_diff = branches[1];
+  const auto &speaker_diff = branches[2];
+  size_t n = cond.size();
+  if (n == 0) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: n is 0"));
+    return;
+  }
+  if (text_diff.size() != n || speaker_diff.size() != n) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: Vector length mismatch"));
+    return;
+  }
+  auto check_finite = [](const std::vector<float>& v) {
+    for (float f : v) {
+      if (!std::isfinite(f)) return false;
+    }
+    return true;
+  };
+  if (!check_finite(cond) || !check_finite(text_diff) || !check_finite(speaker_diff)) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: NaN or Inf detected"));
+    return;
+  }
+
+  const double epsilon = 1e-6;
+  const double effect_epsilon = 1e-5;
+
+  auto calc_rms = [](const std::vector<float>& v) {
+    double sum = 0.0;
+    for (float f : v) { sum += static_cast<double>(f) * static_cast<double>(f); }
+    return std::sqrt(sum / static_cast<double>(v.size()));
+  };
+
+  std::vector<float> v_text(n);
+  for (size_t i = 0; i < n; ++i) {
+    v_text[i] = cond[i] + text_scale * text_diff[i];
+  }
+  double v_text_rms = calc_rms(v_text);
+  double spk_diff_rms = calc_rms(speaker_diff);
+
+  double cosine = 0.0;
+  double proj = 0.0;
+  double parallel_rms = 0.0;
+  double antiparallel_rms = 0.0;
+  double ortho_rms = spk_diff_rms;
+  double axial_rms = 0.0;
+  double decomp_abs_error = 0.0;
+  double decomp_rel_error = 0.0;
+
+  if (v_text_rms >= epsilon && spk_diff_rms >= epsilon) {
+    double dot_vtext_spk = 0.0;
+    for (size_t i = 0; i < n; ++i) {
+      dot_vtext_spk += static_cast<double>(v_text[i]) * static_cast<double>(speaker_diff[i]);
+    }
+    cosine = dot_vtext_spk / (static_cast<double>(n) * v_text_rms * spk_diff_rms);
+    proj = dot_vtext_spk / (static_cast<double>(n) * v_text_rms * v_text_rms);
+
+    std::vector<float> d_parallel(n);
+    std::vector<float> d_ortho(n);
+    for (size_t i = 0; i < n; ++i) {
+      d_parallel[i] = static_cast<float>(proj * static_cast<double>(v_text[i]));
+      d_ortho[i] = speaker_diff[i] - d_parallel[i];
+    }
+    axial_rms = calc_rms(d_parallel);
+    ortho_rms = calc_rms(d_ortho);
+
+    if (proj > 0.0) {
+      parallel_rms = axial_rms;
+    } else {
+      antiparallel_rms = axial_rms;
+    }
+
+    double lhs = spk_diff_rms * spk_diff_rms;
+    double rhs = axial_rms * axial_rms + ortho_rms * ortho_rms;
+    decomp_abs_error = std::abs(lhs - rhs);
+    decomp_rel_error = decomp_abs_error / std::max(lhs, epsilon);
+  }
+
+  std::vector<float> v_final(n);
+  for (size_t i = 0; i < n; ++i) {
+    v_final[i] = v_text[i] + spk_scale * speaker_diff[i];
+  }
+  double final_rms = calc_rms(v_final);
+  double rms_delta = final_rms - v_text_rms;
+  
+  if (!std::isfinite(rms_delta)) {
+    debug::trace_log_scalar("SPK_CFG_ANALYSIS", std::string_view("Skipped: rms_delta is not finite"));
+    return;
+  }
+
+  std::string effect;
+  if (rms_delta > effect_epsilon) { effect = "Amplified"; }
+  else if (rms_delta < -effect_epsilon) { effect = "Attenuated"; }
+  else { effect = "Neutral"; }
+
+  std::string rms_ratio_str;
+  if (v_text_rms >= epsilon) {
+    char buf[32];
+    std::snprintf(buf, sizeof(buf), "%.3f", final_rms / v_text_rms);
+    rms_ratio_str = buf;
+  } else {
+    rms_ratio_str = "N/A";
+  }
+
+  char log_buf[512];
+  if (v_text_rms >= epsilon && spk_diff_rms >= epsilon) {
+    std::snprintf(log_buf, sizeof(log_buf),
+        "step:%d eps:1e-06 text_scale:%.3f spk_scale:%.3f "
+        "v_text_rms:%.3f spk_diff_rms:%.3f cos:%.3f proj:%.3f "
+        "parallel_rms:%.3f antiparallel_rms:%.3f ortho_rms:%.3f "
+        "final_rms:%.3f rms_delta:%.3f rms_ratio:%s effect:%s "
+        "abs_err:%.1e rel_err:%.1e",
+        static_cast<int>(step + 1), text_scale, spk_scale,
+        v_text_rms, spk_diff_rms, cosine, proj,
+        parallel_rms, antiparallel_rms, ortho_rms,
+        final_rms, rms_delta, rms_ratio_str.c_str(), effect.c_str(),
+        decomp_abs_error, decomp_rel_error);
+  } else {
+    std::snprintf(log_buf, sizeof(log_buf),
+        "step:%d eps:1e-06 text_scale:%.3f spk_scale:%.3f "
+        "v_text_rms:%.3f spk_diff_rms:%.3f cos:N/A proj:N/A "
+        "parallel_rms:N/A antiparallel_rms:N/A ortho_rms:%.3f "
+        "final_rms:%.3f rms_delta:%.3f rms_ratio:%s effect:%s "
+        "abs_err:N/A rel_err:N/A",
+        static_cast<int>(step + 1), text_scale, spk_scale,
+        v_text_rms, spk_diff_rms, ortho_rms,
+        final_rms, rms_delta, rms_ratio_str.c_str(), effect.c_str());
+  }
+  debug::trace_log_scalar("SPK_CFG_ANALYSIS ", std::string_view(log_buf));
+}
