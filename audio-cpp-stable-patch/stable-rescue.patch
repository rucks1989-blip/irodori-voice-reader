+void transform_speaker_condition(IrodoriSpeakerCondition &speaker,
+                                 const std::string &variant) {
+  if (variant.empty() || variant == "none" || speaker.state.empty()) {
+    return;
+  }
+  const size_t tokens = static_cast<size_t>(speaker.tokens);
+  if (tokens == 0 || speaker.state.size() % tokens != 0) {
+    throw std::runtime_error("Irodori-TTS speaker simulation shape mismatch");
+  }
+  const size_t dim = speaker.state.size() / tokens;
+  auto begin = [&](size_t token) {
+    return speaker.state.begin() + static_cast<std::ptrdiff_t>(token * dim);
+  };
+  auto end = [&](size_t token) {
+    return begin(token) + static_cast<std::ptrdiff_t>(dim);
+  };
+  if (variant == "zero") {
+    std::fill(speaker.state.begin(), speaker.state.end(), 0.0F);
+    return;
+  }
+  if (variant == "no_voice") {
+    std::fill(speaker.state.begin(), speaker.state.end(), 0.0F);
+    std::fill(speaker.mask.begin(), speaker.mask.end(), 0);
+    speaker.has_speaker = false;
+    return;
+  }
+  if (variant == "scale_0.5" || variant == "scale_1.5") {
+    const float scale = variant == "scale_0.5" ? 0.5F : 1.5F;
+    for (float &value : speaker.state) {
+      value *= scale;
+    }
+    return;
+  }
+  if (variant == "direction") {
+    for (size_t token = 0; token < tokens; ++token) {
+      std::reverse(begin(token), end(token));
+    }
+    return;
+  }
+  if (variant == "variance_shrink" || variant == "variance_expand") {
+    const float scale = variant == "variance_shrink" ? 0.5F : 2.0F;
+    for (size_t token = 0; token < tokens; ++token) {
+      auto first = begin(token);
+      const auto last = end(token);
+      double mean = 0.0;
+      for (auto it = first; it != last; ++it) {
+        mean += *it;
+      }
+      mean /= static_cast<double>(dim);
+      for (auto it = first; it != last; ++it) {
+        *it = static_cast<float>(mean + (*it - mean) * scale);
+      }
+    }
+    return;
+  }
+  if (variant == "mean_only") {
+    auto first = begin(0);
+    const auto last = end(0);
+    double sum_squared = 0.0;
+    for (auto it = first; it != last; ++it) {
+      sum_squared += static_cast<double>(*it) * *it;
+    }
+    const float offset = static_cast<float>(
+        std::sqrt(sum_squared / static_cast<double>(dim)) * 0.5);
+    for (auto it = first; it != last; ++it) {
+      *it += offset;
+    }
+    return;
+  }
+  if (variant == "speaker_tokens") {
+    for (size_t token = 1; token < tokens; ++token) {
+      for (auto it = begin(token); it != end(token); ++it) {
+        *it *= 1.5F;
+      }
+    }
+    return;
+  }
+  throw std::runtime_error("unknown Irodori-TTS speaker simulation variant: " +
+                           variant);
+}
