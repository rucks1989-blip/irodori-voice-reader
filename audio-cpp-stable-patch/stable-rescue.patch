+template <typename T>
+std::string vector_stats(const std::vector<T> &values) {
+  if (values.empty()) {
+    return "n=0";
+  }
+  double minimum = std::numeric_limits<double>::infinity();
+  double maximum = -std::numeric_limits<double>::infinity();
+  long double sum = 0.0L;
+  long double sum_squared = 0.0L;
+  size_t finite = 0;
+  for (const T value : values) {
+    const double converted = static_cast<double>(value);
+    if (!std::isfinite(converted)) {
+      continue;
+    }
+    minimum = std::min(minimum, converted);
+    maximum = std::max(maximum, converted);
+    sum += converted;
+    sum_squared += static_cast<long double>(converted) * converted;
+    ++finite;
+  }
+  if (finite == 0) {
+    return "n=" + std::to_string(values.size()) + ",finite=0";
+  }
+  std::ostringstream out;
+  out << "n=" << values.size() << ",finite=" << finite
+      << ",min=" << minimum << ",max=" << maximum
+      << ",mean=" << static_cast<double>(sum / finite)
+      << ",rms=" << std::sqrt(static_cast<double>(sum_squared / finite));
+  return out.str();
+}
+
+std::string token_list(const std::vector<int32_t> &tokens) {
+  std::ostringstream out;
+  for (size_t index = 0; index < tokens.size(); ++index) {
+    if (index != 0) {
+      out << ',';
+    }
+    out << tokens[index];
+  }
+  return out.str();
+}
+
+double vector_rms(const std::vector<float> &values) {
+  if (values.empty()) {
+    return 0.0;
+  }
+  long double sum_squared = 0.0L;
+  for (const float value : values) {
+    sum_squared += static_cast<long double>(value) * value;
+  }
+  return std::sqrt(static_cast<double>(sum_squared / values.size()));
+}
+
+double vector_max_abs(const std::vector<float> &values) {
+  double maximum = 0.0;
+  for (const float value : values) {
+    maximum = std::max(maximum, std::abs(static_cast<double>(value)));
+  }
+  return maximum;
+}
+
+double vector_cosine(const std::vector<float> &lhs,
+                     const std::vector<float> &rhs) {
+  if (lhs.size() != rhs.size() || lhs.empty()) {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+  long double dot = 0.0L;
+  long double lhs_squared = 0.0L;
+  long double rhs_squared = 0.0L;
+  for (size_t index = 0; index < lhs.size(); ++index) {
+    dot += static_cast<long double>(lhs[index]) * rhs[index];
+    lhs_squared += static_cast<long double>(lhs[index]) * lhs[index];
+    rhs_squared += static_cast<long double>(rhs[index]) * rhs[index];
+  }
+  if (lhs_squared == 0.0L || rhs_squared == 0.0L) {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+  return static_cast<double>(dot / std::sqrt(lhs_squared * rhs_squared));
+}
+
+std::vector<float> subtract_vectors(const std::vector<float> &lhs,
+                                    const std::vector<float> &rhs) {
+  if (lhs.size() != rhs.size()) {
+    return {};
+  }
+  std::vector<float> out(lhs.size());
+  for (size_t index = 0; index < lhs.size(); ++index) {
+    out[index] = lhs[index] - rhs[index];
+  }
+  return out;
+}
