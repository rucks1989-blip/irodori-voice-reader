+void log_layer_forensics(const std::string &prefix,
+                         const IrodoriRfStepDiagnostics &diagnostics,
+                         bool text_cfg_enabled, bool speaker_cfg_enabled,
+                         bool caption_cfg_enabled) {
+  if (!speaker_cfg_enabled || diagnostics.layer_hidden.empty()) {
+    return;
+  }
+  const size_t batch =
+      1 + static_cast<size_t>(text_cfg_enabled) +
+      static_cast<size_t>(speaker_cfg_enabled) +
+      static_cast<size_t>(caption_cfg_enabled);
+  const size_t text_branch = text_cfg_enabled ? 1 : 0;
+  const size_t speaker_branch = 1 + static_cast<size_t>(text_cfg_enabled);
+  for (size_t layer = 0; layer < diagnostics.layer_hidden.size(); ++layer) {
+    const auto &values = diagnostics.layer_hidden[layer];
+    if (batch == 0 || values.empty() || values.size() % batch != 0) {
+      continue;
+    }
+    const size_t branch_values = values.size() / batch;
+    const size_t speaker_offset = speaker_branch * branch_values;
+    long double cond_squared = 0.0L;
+    long double speaker_uncond_squared = 0.0L;
+    long double speaker_diff_squared = 0.0L;
+    long double cond_speaker_dot = 0.0L;
+    long double text_diff_squared = 0.0L;
+    long double text_speaker_diff_dot = 0.0L;
+    const size_t text_offset = text_branch * branch_values;
+    for (size_t index = 0; index < branch_values; ++index) {
+      const long double cond = values[index];
+      const long double speaker_uncond = values[speaker_offset + index];
+      const long double speaker_diff = cond - speaker_uncond;
+      cond_squared += cond * cond;
+      speaker_uncond_squared += speaker_uncond * speaker_uncond;
+      speaker_diff_squared += speaker_diff * speaker_diff;
+      cond_speaker_dot += cond * speaker_uncond;
+      if (text_cfg_enabled) {
+        const long double text_diff = cond - values[text_offset + index];
+        text_diff_squared += text_diff * text_diff;
+        text_speaker_diff_dot += text_diff * speaker_diff;
+      }
+    }
+    const double count = static_cast<double>(branch_values);
+    const double cond_rms =
+        std::sqrt(static_cast<double>(cond_squared) / count);
+    const double speaker_uncond_rms =
+        std::sqrt(static_cast<double>(speaker_uncond_squared) / count);
+    const double speaker_diff_rms =
+        std::sqrt(static_cast<double>(speaker_diff_squared) / count);
+    const double cond_speaker_cosine =
+        cond_squared > 0.0L && speaker_uncond_squared > 0.0L
+            ? static_cast<double>(
+                  cond_speaker_dot /
+                  std::sqrt(cond_squared * speaker_uncond_squared))
+            : std::numeric_limits<double>::quiet_NaN();
+    const std::string layer_prefix =
+        prefix + "layer." + std::to_string(layer) + ".";
+    debug::trace_log_scalar(layer_prefix + "cond_rms", cond_rms);
+    debug::trace_log_scalar(layer_prefix + "speaker_uncond_rms",
+                            speaker_uncond_rms);
+    debug::trace_log_scalar(layer_prefix + "speaker_diff_rms",
+                            speaker_diff_rms);
+    debug::trace_log_scalar(layer_prefix + "speaker_diff_to_cond_ratio",
+                            cond_rms > 0.0 ? speaker_diff_rms / cond_rms : 0.0);
+    debug::trace_log_scalar(layer_prefix + "cond_speaker_uncond_cosine",
+                            cond_speaker_cosine);
+    if (text_cfg_enabled) {
+      const double text_diff_rms =
+          std::sqrt(static_cast<double>(text_diff_squared) / count);
+      const double text_speaker_diff_cosine =
+          text_diff_squared > 0.0L && speaker_diff_squared > 0.0L
+              ? static_cast<double>(
+                    text_speaker_diff_dot /
+                    std::sqrt(text_diff_squared * speaker_diff_squared))
+              : std::numeric_limits<double>::quiet_NaN();
+      debug::trace_log_scalar(layer_prefix + "text_diff_rms", text_diff_rms);
+      debug::trace_log_scalar(layer_prefix + "text_speaker_diff_cosine",
+                              text_speaker_diff_cosine);
+    }
+  }
+  const size_t sublayer_count = std::min(
+      diagnostics.layer_attention_hidden.size(),
+      diagnostics.layer_hidden.empty() ? size_t{0}
+                                       : diagnostics.layer_hidden.size() - 1);
+  for (size_t layer = 0; layer < sublayer_count; ++layer) {
+    const auto &input = diagnostics.layer_hidden[layer];
+    const auto &attention = diagnostics.layer_attention_hidden[layer];
+    const auto &output = diagnostics.layer_hidden[layer + 1];
+    if (input.size() != attention.size() || input.size() != output.size() ||
+        input.empty() || input.size() % batch != 0) {
+      continue;
+    }
+    const size_t branch_values = input.size() / batch;
+    const size_t speaker_offset = speaker_branch * branch_values;
+    long double attention_diff_squared = 0.0L;
+    long double attention_increment_squared = 0.0L;
+    long double mlp_increment_squared = 0.0L;
+    for (size_t index = 0; index < branch_values; ++index) {
+      const long double input_diff =
+          static_cast<long double>(input[index]) -
+          input[speaker_offset + index];
+      const long double attention_diff =
+          static_cast<long double>(attention[index]) -
+          attention[speaker_offset + index];
+      const long double output_diff =
+          static_cast<long double>(output[index]) -
+          output[speaker_offset + index];
+      const long double attention_increment = attention_diff - input_diff;
+      const long double mlp_increment = output_diff - attention_diff;
+      attention_diff_squared += attention_diff * attention_diff;
+      attention_increment_squared +=
+          attention_increment * attention_increment;
+      mlp_increment_squared += mlp_increment * mlp_increment;
+    }
+    const double count = static_cast<double>(branch_values);
+    const std::string layer_prefix =
+        prefix + "layer." + std::to_string(layer + 1) + ".";
+    debug::trace_log_scalar(
+        layer_prefix + "attention_speaker_diff_rms",
+        std::sqrt(static_cast<double>(attention_diff_squared) / count));
+    debug::trace_log_scalar(
+        layer_prefix + "attention_increment_speaker_diff_rms",
+        std::sqrt(static_cast<double>(attention_increment_squared) / count));
+    debug::trace_log_scalar(
+        layer_prefix + "mlp_increment_speaker_diff_rms",
+        std::sqrt(static_cast<double>(mlp_increment_squared) / count));
+  }
+}
+
+float apply_adaptive_speaker_guidance(
+    const IrodoriRfStepDiagnostics &diagnostics, bool text_cfg_enabled,
+    bool caption_cfg_enabled, float text_guidance_scale,
+    float speaker_guidance_scale, float caption_guidance_scale,
+    float target_ratio, std::vector<float> &velocity) {
+  const size_t count = diagnostics.cond.size();
+  if (count == 0 || diagnostics.speaker_diff.size() != count ||
+      (text_cfg_enabled && diagnostics.text_diff.size() != count) ||
+      (caption_cfg_enabled && diagnostics.caption_diff.size() != count)) {
+    throw std::runtime_error(
+        "Irodori-TTS adaptive speaker guidance diagnostics mismatch");
+  }
+
+  std::vector<float> base_velocity = diagnostics.cond;
+  if (text_cfg_enabled) {
+    for (size_t index = 0; index < count; ++index) {
+      base_velocity[index] +=
+          text_guidance_scale * diagnostics.text_diff[index];
+    }
+  }
+  if (caption_cfg_enabled) {
+    for (size_t index = 0; index < count; ++index) {
+      base_velocity[index] +=
+          caption_guidance_scale * diagnostics.caption_diff[index];
+    }
+  }
+
+  const double base_rms = vector_rms(base_velocity);
+  const double speaker_diff_rms = vector_rms(diagnostics.speaker_diff);
+  float effective_scale = speaker_guidance_scale;
+  if (base_rms > 0.0 && speaker_diff_rms > 0.0) {
+    const double maximum_scale =
+        static_cast<double>(target_ratio) * base_rms / speaker_diff_rms;
+    effective_scale = std::copysign(
+        static_cast<float>(
+            std::min(std::abs(static_cast<double>(speaker_guidance_scale)),
+                     maximum_scale)),
+        speaker_guidance_scale);
+  }
+
+  velocity.resize(count);
+#ifdef _OPENMP
+#pragma omp parallel for if(count >= 4096)
+#endif
+  for (int64_t index = 0; index < static_cast<int64_t>(count); ++index) {
+    const size_t position = static_cast<size_t>(index);
+    velocity[position] =
+        base_velocity[position] +
+        effective_scale * diagnostics.speaker_diff[position];
+  }
+  return effective_scale;
+}
