+uint64_t fnv1a_bytes(uint64_t hash, const void *data, size_t size) {
+  constexpr uint64_t kPrime = 1099511628211ULL;
+  const auto *bytes = static_cast<const uint8_t *>(data);
+  for (size_t index = 0; index < size; ++index) {
+    hash ^= bytes[index];
+    hash *= kPrime;
+  }
+  return hash;
+}
+
+uint64_t speaker_condition_hash(const IrodoriSpeakerCondition &speaker) {
+  uint64_t hash = 1469598103934665603ULL;
+  hash = fnv1a_bytes(hash, &speaker.tokens, sizeof(speaker.tokens));
+  hash = fnv1a_bytes(hash, &speaker.has_speaker, sizeof(speaker.has_speaker));
+  if (!speaker.state.empty()) {
+    hash = fnv1a_bytes(hash, speaker.state.data(),
+                       speaker.state.size() * sizeof(speaker.state.front()));
+  }
+  if (!speaker.mask.empty()) {
+    hash = fnv1a_bytes(hash, speaker.mask.data(), speaker.mask.size());
+  }
+  return hash;
+}
